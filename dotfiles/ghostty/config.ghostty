#Font
font-family = "AnnotationM Nerd Font Mono"
font-size = 18

font-feature = +liga
font-feature = +ss01
font-feature = +onum
font-feature = +cv02
font-feature = +cv05
font-feature = +cv09
font-feature = +cv11
font-feature = +cv31
font-feature = +cv38
font-feature = +cv42
font-feature = +cv44
font-feature = +cv62
font-feature = +ss03
font-feature = +ss05
font-feature = +ss07
font-feature = +ss08
font-feature = +ss09
font-feature = +ss10
font-feature = +ss11



#Cursor
shell-integration-features = no-cursor
cursor-style = block_hollow
cursor-style-blink = false
cursor-click-to-move = true

#Style
background-blur = true
custom-shader = shaders/cursor_sweep.glsl
theme = Gruvbox Dark Hard
