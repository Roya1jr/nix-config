#Font
font-family = "Maple Mono NF"
font-size = 18
font-feature = cv01
font-feature = cv02
font-feature = cv33
font-feature = cv34
font-feature = cv35
font-feature = cv36
font-feature = cv61
font-feature = cv62
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08


#Cursor
shell-integration-features = no-cursor
cursor-style = block_hollow
cursor-style-blink = false
cursor-click-to-move = true

#Style
background-blur = true
custom-shader = shaders/cursor_sweep.glsl
theme = Gruvbox Dark Hard
