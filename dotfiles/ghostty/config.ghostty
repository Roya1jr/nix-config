#Font
font-family = "Maple Mono NF CN"
font-size = 18
#ligatures
 font-feature = +calt
 font-feature = -zero
#upright
 font-feature = -cv01
 font-feature = +cv02
 font-feature = +cv03
 font-feature = -cv04
 font-feature = +cv05
 font-feature = +cv06
 font-feature = -cv07
 font-feature = -cv08
 font-feature = +cv09
 font-feature = -cv10
 font-feature = -cv11
 font-feature = -cv61
 font-feature = -cv62
 font-feature = -cv63
 font-feature = -cv64
 font-feature = -cv65
 font-feature = -cv66
#italics
 font-feature = -cv31
 font-feature = -cv32
 font-feature = -cv33
 font-feature = -cv34
 font-feature = -cv35
 font-feature = -cv36
 font-feature = -cv37
 font-feature = +cv38
 font-feature = -cv39
 font-feature = +cv40
 font-feature = +cv41
 font-feature = +cv42
 font-feature = -cv43
 font-feature = -cv44
#stylistic sets
 font-feature = -ss01
 font-feature = -ss02
 font-feature = +ss03
 font-feature = +ss04
 font-feature = +ss05
 font-feature = -ss06
 font-feature = +ss07
 font-feature = +ss08
 font-feature = +ss09
 font-feature = +ss10
 font-feature = +ss11

#Cursor
shell-integration-features = no-cursor
cursor-style = block_hollow
cursor-style-blink = false
cursor-click-to-move = true

#Style
background-blur = true
custom-shader = shaders/cursor_sweep.glsl
theme = Gruvbox Dark Hard
