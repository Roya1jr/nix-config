[init]
	defaultBranch = "main"

[pull]
	rebase = true

[user]
	email = "prince.mguni@outlook.com"
	name = "Prince Junior Mguni"
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
    format = ssh

[commit]
    gpgsign = true
    verbose = true

[tag]
    gpgsign = true

[core]
    editor = hx
    pager  = delta

[interactive]
    diffFilter = delta --color-only

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true

[rerere]
    enabled = true
